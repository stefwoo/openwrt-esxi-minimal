#!/bin/sh

# Nikki (Mihomo) GeoIP 和 GeoSite 数据库配置

# 创建 Nikki 运行目录
mkdir -p /etc/nikki/run

# 下载 GeoIP 数据库
echo "正在下载 geoip.metadb..."
wget -O /etc/nikki/run/geoip.metadb \
  https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb || \
  curl -L -o /etc/nikki/run/geoip.metadb \
  https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb || \
  echo "geoip.metadb 下载失败"

# 下载 GeoSite 数据库
echo "正在下载 geosite.dat..."
wget -O /etc/nikki/run/geosite.dat \
  https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat || \
  curl -L -o /etc/nikki/run/geosite.dat \
  https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat || \
  echo "geosite.dat 下载失败"

# 设置文件权限
chmod 644 /etc/nikki/run/geoip.metadb 2>/dev/null || true
chmod 644 /etc/nikki/run/geosite.dat 2>/dev/null || true

echo "Nikki Geo 数据库配置完成"
exit 0
